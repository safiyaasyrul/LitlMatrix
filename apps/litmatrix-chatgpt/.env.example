# LitlMatrix ChatGPT App — Phase 6
PORT=3001
HOST=0.0.0.0
ALLOWED_ORIGIN=https://chatgpt.com

# PostgreSQL persistent storage
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/litmatrix

# OAuth/JWT resource-server configuration
# The MCP host obtains the access token from your configured authorization server.
AUTH_ISSUER=https://YOUR-IDP.example.com
AUTH_AUDIENCE=https://YOUR-LITMATRIX-MCP.example.com/mcp
AUTH_JWKS_URL=https://YOUR-IDP.example.com/.well-known/jwks.json
AUTH_AUTHORIZATION_SERVER=https://YOUR-IDP.example.com
AUTH_AUTHORIZATION_ENDPOINT=https://YOUR-IDP.example.com/oauth/authorize
AUTH_TOKEN_ENDPOINT=https://YOUR-IDP.example.com/oauth/token
AUTH_SCOPES=openid profile email

# Development only. NEVER enable this on a public deployment.
ALLOW_ANONYMOUS_DEV=false
