# Neon PostgreSQL
DATABASE_URL=postgresql://...

# Clerk OAuth authorization server (from your Clerk Frontend API URL)
AUTH_ISSUER=https://YOUR-CLERK-DOMAIN.clerk.accounts.dev
AUTH_JWKS_URL=https://YOUR-CLERK-DOMAIN.clerk.accounts.dev/.well-known/jwks.json
AUTH_AUTHORIZATION_SERVER=https://YOUR-CLERK-DOMAIN.clerk.accounts.dev
AUTH_AUTHORIZATION_ENDPOINT=https://YOUR-CLERK-DOMAIN.clerk.accounts.dev/oauth/authorize
AUTH_TOKEN_ENDPOINT=https://YOUR-CLERK-DOMAIN.clerk.accounts.dev/oauth/token
AUTH_SCOPES=openid profile email offline_access
PUBLIC_MCP_BASE_URL=https://litl-matrix-api-server.vercel.app

# Optional. Leave empty unless your Clerk OAuth access-token audience is configured and you want strict audience validation.
AUTH_AUDIENCE=

# Optional exact email allowlist. When set, only these authenticated email addresses may use LitlMatrix.
# Example: researcher1@umt.edu.my,researcher2@umt.edu.my
LITMATRIX_ALLOWED_EMAILS=

# Production: false. Local-only development may set true when auth is not configured.
ALLOW_ANONYMOUS_DEV=false

# Comma-separated origins allowed to call the HTTP service.
ALLOWED_ORIGIN=https://YOUR-VERCEL-DOMAIN
